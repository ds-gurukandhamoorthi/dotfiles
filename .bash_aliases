unalias z
alias v.='v ~+'
alias v..='v ~+/..'


alias gzip='pigz'  
alias gunzip='unpigz'  

alias xpdf='zathura -d /tmp/$(date +zathura_remember_me_not%s%N)'


alias rvlc='rvlc --one-instance --playlist-enqueue --play-and-exit'


